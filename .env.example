# Copy this file to `.env` and fill in real values.
# `.env` is git-ignored — never commit real credentials.

# ---------------------------------------------------------------------------
# General
# ---------------------------------------------------------------------------
# DRY_RUN=true means no real HTTP write calls are ever sent to any platform
# API (price updates are computed and logged/reported, not executed).
# Keep this "true" until you explicitly decide to go live.
DRY_RUN=true

# Directory for local state (SQLite DB, token cache). Defaults to ./data
DATA_DIR=./data

# ---------------------------------------------------------------------------
# Google Sheets
# ---------------------------------------------------------------------------
# The spreadsheet ID from its URL:
# https://docs.google.com/spreadsheets/d/<THIS_PART>/edit
GOOGLE_SHEET_ID=1A5hVB4PN4TDurhwb4cPjtcuDgvK7XalwmekDfSne3Ss
# Confirmed live 2026-09-19: "محصولات سایت جدید" (the production tab) is
# gid=391280922 — NOT the gid=0 default, which is a different, older tab.
GOOGLE_SHEET_WORKSHEET_GID=391280922
# Selecting by name takes precedence over the gid above when both are set.
GOOGLE_SHEET_WORKSHEET_NAME=محصولات سایت جدید

# Path to a Google service-account JSON key with at least read access to the
# sheet above (share the sheet with the service account's client_email).
# NOT PROVIDED YET — see README "Still needed from you".
GOOGLE_SERVICE_ACCOUNT_FILE=./config/google_service_account.json

# PRODUCTION SOURCE IS THE LIVE GOOGLE SHEET (above), always, unless you
# explicitly set this. This is a DEVELOPMENT/TESTING FALLBACK ONLY — when
# set, it's used INSTEAD of the Google Sheets API. Leave blank in
# production/on the VPS so the app always reads the live sheet.
PRODUCT_SOURCE_CSV_PATH=

# ---------------------------------------------------------------------------
# DigiKala (Seller Open API)
# ---------------------------------------------------------------------------
DIGIKALA_BASE_URL=https://seller.digikala.com

# Bootstrap credentials, used only if no tokens file (see
# ORDER_SYNC_DATA_DIR below) or persisted tokens.json exists yet.
DIGIKALA_ACCESS_TOKEN=
DIGIKALA_REFRESH_TOKEN=

# Safety switch — and cross-project ownership switch: DigiKala's
# refresh_token is rotating/single-use, and order-sync-platform (the
# sibling "Local Marketplace Order Synchronization Platform" project,
# which shares this exact DigiKala account) is the process responsible
# for actually calling the refresh endpoint. MUST stay false here, or the
# two projects will invalidate each other's tokens.
DIGIKALA_ENABLE_TOKEN_REFRESH=false

# NOTE ON NAMES: in the bot, the MAIN DigiKala account (sheet column
# "دیجی کالا اصلی") is platform "digikala" and the FAST account (sheet column
# "دیجی کالا سریع") is platform "digikala2". The .env variable names were
# deliberately NOT renamed so existing .env files keep working:
#   DIGIKALA_ASLI_*  -> main account, platform "digikala"  (Telegram: Digikala)
#   DIGIKALA_*       -> fast account, platform "digikala2" (Telegram: Digikala Saree)
# The block above (DIGIKALA_ACCESS_TOKEN / _REFRESH_TOKEN / _ENABLE_TOKEN_REFRESH)
# is therefore the FAST account.
#
# Main account (دیجی کالا اصلی) — a second, independent DigiKala seller
# account, also shared with order-sync-platform (its primary DIGIKALA_*
# account there). Completely separate bootstrap credentials from the
# fast account above; same refresh-ownership rule applies.
DIGIKALA_ASLI_ACCESS_TOKEN=
DIGIKALA_ASLI_REFRESH_TOKEN=
DIGIKALA_ASLI_ENABLE_TOKEN_REFRESH=false

# Absolute path to order-sync-platform's own data/ folder on this machine
# (e.g. C:\Users\OMEN\Desktop\Local Marketplace Order Synchronization
# Platform\data). That project owns real DigiKala token refresh for both
# accounts above and writes digikala_tokens.json (main) and
# digikala2_tokens.json (fast) there; this project only reads them from
# that path. Leave blank only if order-sync-platform is not deployed
# alongside this project — tokens then fall back to this project's own
# DATA_DIR/tokens.json and tokens_asli.json, which is not safe to run at
# the same time as order-sync-platform against the same accounts.
ORDER_SYNC_DATA_DIR=

# Minimum seconds enforced between consecutive DigiKala requests of the same
# kind, to reduce HTTP 429 rate-limiting. Reads and writes are throttled
# independently, and the very first request of each kind is never delayed.
# Read = variant search / fetching product/price info (GET).
DIGIKALA_READ_DELAY_SECONDS=1
# Write = price update (PUT). Kept higher than the read delay since writes
# are the more rate-limit-sensitive request DigiKala makes us pay for.
DIGIKALA_WRITE_DELAY_SECONDS=2

# ---------------------------------------------------------------------------
# SnappShop Tehran (اسنپ‌شاپ تهران)
# ---------------------------------------------------------------------------
# Official SnappShop Automation API base URL. The earlier reverse-engineered
# /vendors/v1/{vendor}/inventory/products... endpoints are deprecated.
SNAPPSHOP_BASE_URL=https://apix.snappshop.ir/automation/v1

# Permanent Bearer JWT token, the store's 6-character vendor id (e.g.
# 0dPKQ4), and the agent-user string (starts with "SNV_...") for the
# SnappShop Automation API — all three issued from the SnappShop seller
# panel. NOT interchangeable: the vendor id identifies the store and is
# used in the URL; the agent user identifies the calling agent and is sent
# only via the User-Agent header. Using the agent string as the vendor id
# produces SnappShop error 301008 ("عدم دسترسی").
# NOT PROVIDED YET.
SNAPPSHOP_TOKEN=
SNAPPSHOP_VENDOR_CODE=
SNAPPSHOP_AGENT_USER=

# Optional HTTP(S) proxy for SnappShop requests only (e.g. an Iranian exit
# IP). SnappShop's API can return HTTP 403 with an HTML VPN/IP-restriction
# page when called from outside Iran (see platforms/snappshop/client.py) —
# set this if that happens. Leave blank if already running from an Iranian
# IP. Format: http://user:pass@host:port or http://host:port
SNAPPSHOP_PROXY_URL=

# Same rate-limit-throttling pattern as DIGIKALA_READ/WRITE_DELAY_SECONDS
# above, independent of DigiKala's — reads and writes throttled separately.
# Shared by both SnappShop accounts below (same API).
SNAPPSHOP_READ_DELAY_SECONDS=1
SNAPPSHOP_WRITE_DELAY_SECONDS=2

# "Isfahan" account (اسنپ شاپ اصفهان) — a second, independent SnappShop
# seller account, reusing the exact same Automation API/client code as
# Tehran above. NOT PROVIDED YET. Never the same token/vendor
# code/agent user as Tehran's SNAPPSHOP_TOKEN/SNAPPSHOP_VENDOR_CODE/
# SNAPPSHOP_AGENT_USER above.
SNAPPSHOP_ISFAHAN_TOKEN=
SNAPPSHOP_ISFAHAN_VENDOR_CODE=
SNAPPSHOP_ISFAHAN_AGENT_USER=

# ---------------------------------------------------------------------------
# TapsiShop (تپسی شاپ)
# ---------------------------------------------------------------------------
TAPSI_BASE_URL=https://vendorgw.tapsi.shop

# Single static token, sent as-is (NOT "Bearer <token>") in the
# Tapsi-Shop-Hub-Authorization header — see platforms/tapsishop/client.py.
# NOT PROVIDED YET.
TAPSI_TOKEN=

# Same rate-limit-throttling pattern as the other platforms above —
# independent of DigiKala's/SnappShop's, reads and writes throttled
# separately.
TAPSI_READ_DELAY_SECONDS=1
TAPSI_WRITE_DELAY_SECONDS=2

# ---------------------------------------------------------------------------
# Basalam (باسلام) — store "فراز هنر"
# ---------------------------------------------------------------------------
BASALAM_BASE_URL=https://openapi.basalam.com/v1

# Single static access token, sent as "Bearer <token>" in the standard
# Authorization header — see platforms/basalam/client.py. NOT PROVIDED YET.
BASALAM_ACCESS_TOKEN=

# Same rate-limit-throttling pattern as the other platforms above —
# independent of DigiKala's/SnappShop's/TapsiShop's, reads and writes
# throttled separately.
BASALAM_READ_DELAY_SECONDS=1
BASALAM_WRITE_DELAY_SECONDS=2

# ---------------------------------------------------------------------------
# WooCommerce (وردپرس) — Faraz Honar's own WordPress/WooCommerce store
# ---------------------------------------------------------------------------
WOOCOMMERCE_BASE_URL=https://farazhonar.com/wp-json/wc/v3

# Consumer key/secret pair from WooCommerce > Settings > Advanced > REST API.
# IMPORTANT: farazhonar.com's firewall blocks standard HTTP Basic Auth and
# plain PUT requests, so this client sends the key/secret as URL query
# parameters (never an Authorization header) and always uses POST — see
# platforms/woocommerce/client.py. NOT PROVIDED YET.
WOOCOMMERCE_CONSUMER_KEY=
WOOCOMMERCE_CONSUMER_SECRET=

# Same rate-limit-throttling pattern as the other platforms above —
# independent of DigiKala's/SnappShop's/TapsiShop's/Basalam's, reads and
# writes throttled separately.
WOOCOMMERCE_READ_DELAY_SECONDS=1
WOOCOMMERCE_WRITE_DELAY_SECONDS=2

# ---------------------------------------------------------------------------
# Telegram
# ---------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
# Comma-separated numeric Telegram user IDs allowed to control the bot.
TELEGRAM_ALLOWED_USER_IDS=
# Comma-separated numeric Telegram chat IDs that should receive the bot's
# reports (hourly recheck report, and every manual-run message: start
# banner, DRY_RUN banner, final report, stopped/unexpected-error messages).
# Example: TELEGRAM_CHAT_IDS=123456789,987654321,555555555
# Separate from TELEGRAM_ALLOWED_USER_IDS above (that's about who may send
# commands; this is about who receives reports). Leave blank to keep the
# previous single-recipient behavior (a manual run reports back only to
# the chat that triggered it; the hourly recheck reports to
# TELEGRAM_ALLOWED_USER_IDS).
TELEGRAM_CHAT_IDS=

# Chat ID of the one person who should also get a separate, admin-only
# version of every manual run's final report: only the not-corrected
# products, each with its exact failure reason. Everyone else (every other
# recipient above) gets the clean team version instead: product names only,
# no failure reasons. Leave blank to send no admin report.
# Example: ADMIN_CHAT_ID=123456789
ADMIN_CHAT_ID=

# Optional numbered per-person slots (up to 10): a numeric chat ID plus a
# display name paired with the same number. Every filled TELEGRAM_CHAT_ID_N is
# also allowed to control the bot, and its name is what shows up in "who did
# what" notices (falls back to the numeric ID if no name is set). Blank slots
# are ignored; leaving all of them blank changes nothing.
# Example: TELEGRAM_CHAT_ID_1=123456789 / TELEGRAM_CHAT_NAME_1=آقای اعتصامی
# Remember to also list every ID in TELEGRAM_CHAT_IDS above if that person
# should receive the reports (these slots alone only give access + notices).
TELEGRAM_CHAT_ID_1=
TELEGRAM_CHAT_NAME_1=
TELEGRAM_CHAT_ID_2=
TELEGRAM_CHAT_NAME_2=
TELEGRAM_CHAT_ID_3=
TELEGRAM_CHAT_NAME_3=
TELEGRAM_CHAT_ID_4=
TELEGRAM_CHAT_NAME_4=
TELEGRAM_CHAT_ID_5=
TELEGRAM_CHAT_NAME_5=
TELEGRAM_CHAT_ID_6=
TELEGRAM_CHAT_NAME_6=
TELEGRAM_CHAT_ID_7=
TELEGRAM_CHAT_NAME_7=
TELEGRAM_CHAT_ID_8=
TELEGRAM_CHAT_NAME_8=
TELEGRAM_CHAT_ID_9=
TELEGRAM_CHAT_NAME_9=
TELEGRAM_CHAT_ID_10=
TELEGRAM_CHAT_NAME_10=

# ---------------------------------------------------------------------------
# Business rules
# ---------------------------------------------------------------------------
MAX_PRICE_INCREASE_PCT=0.12
# Applies only to retryable errors (HTTP 5xx / network). 2 = 1 retry.
# HTTP 429 and auth/config/invalid-data errors never retry, regardless of
# this value — they stop after exactly 1 attempt.
MAX_RETRY_ATTEMPTS=2
# Error rounds: after a platform's first full pass, products that failed only
# because of a transient error (HTTP 408/425/429/5xx, timeout, network drop)
# are retried in extra rounds, each round only on the products that failed in
# the previous one. Stops when none are left, when the count stops shrinking,
# or when you press Stop. Permanent errors (400/404/422, auth, missing
# identifier, ...) and 12%-capped products are never retried this way.
# false = a single pass, exactly as before.
ERROR_ROUNDS_ENABLED=true
# Pause (seconds) between two rounds so rate limits can clear. Cancel works
# during the pause. 0 = no pause.
ERROR_ROUNDS_COOLDOWN_SECONDS=60
# Off by default. When true, every HOURLY_RECHECK_MINUTES the bot re-attempts
# products still limited by the 12% rule and sends a separate Telegram report.
# Capped products are already listed in each manual run's final report.
HOURLY_RECHECK_ENABLED=false
HOURLY_RECHECK_MINUTES=60
# Keeps the hourly recheck out of phase with order-sync-platform's
# POLL_INTERVAL_SECONDS cadence even if both processes start at once.
SCHEDULE_OFFSET_SECONDS=45

# ---------------------------------------------------------------------------
# Telegram resilience / alerts
# ---------------------------------------------------------------------------
# Timeout (seconds) for every Telegram request (python-telegram-bot's own
# default is ~5 s, too low for a slow/unstable link).
TELEGRAM_REQUEST_TIMEOUT_SECONDS=30
# Optional proxy for api.telegram.org only, e.g. http://127.0.0.1:10809
# Leave blank for a direct connection.
TELEGRAM_PROXY_URL=
# Alerts to ADMIN_CHAT_ID: connection trouble, unexpected bot errors, and a
# "bot started" notice. Set false to silence.
TELEGRAM_ALERTS_ENABLED=true
# At most one connection alert per this many minutes.
TELEGRAM_ALERT_COOLDOWN_MINUTES=30
